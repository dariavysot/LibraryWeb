@model IEnumerable<LibraryWeb.Models.User>

@{
    ViewData["Title"] = "Управління користувачами";
}

<h2 class="mb-4">Управління користувачами</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}


<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Ім’я</th>
            <th>Email</th>
            <th>Телефон</th>
            <th>Роль</th>
            <th>Тип членства</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserID</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>@user.Phone</td>
                <td>
                    @switch (user.Role)
                    {
                        case LibraryWeb.Models.UserRole.Admin:
                            <span class="badge bg-danger">Адміністратор</span>
                            break;
                        case LibraryWeb.Models.UserRole.Employee:
                            <span class="badge bg-warning text-dark">Працівник</span>
                            break;
                        default:
                            <span class="badge bg-primary">Користувач</span>
                            break;
                    }
                </td>
                <td>
                    @(user.Membership != null ? user.Membership.Type : "—")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@user.UserID" class="btn btn-sm btn-primary me-2">Редагувати</a>

                    <form asp-action="Delete" asp-route-id="@user.UserID" method="post" style="display:inline;">
                        <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Ви впевнені, що хочете видалити цього користувача?');">
                            Видалити
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Admin" asp-action="Dashboard" class="btn btn-secondary mt-3">← Назад до панелі адміністратора</a>
