@model IEnumerable<LibraryWeb.Models.User>

@{
    ViewData["Title"] = "User Management";
}

<main class="admin-page">
    <div class="admin-container">
        <h1 class="admin-title">User Management</h1>

        @if (TempData["Error"] != null)
        {
            <div class="alert admin-alert-error">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert admin-alert-success">@TempData["Success"]</div>
        }

        <form method="get" class="admin-filter-form">
            <input type="text" name="search" class="form-control" placeholder="Search by name or email..."
                   value="@ViewBag.Search" />
            <select name="role" class="form-select">
                <option value="">All Roles</option>
                <option value="Admin" selected="@(ViewBag.Role?.ToString() == "Admin")">Administrator</option>
                <option value="Employee" selected="@(ViewBag.Role?.ToString() == "Employee")">Employee</option>
                <option value="User" selected="@(ViewBag.Role?.ToString() == "User")">User</option>
            </select>
            <select name="membershipType" class="form-select">
                <option value="">All Memberships</option>
                @foreach (var type in (ViewBag.MembershipTypes as List<string> ?? new List<string>()))
                {
                    <option value="@type" selected="@(ViewBag.MembershipType == type)">@type</option>
                }
            </select>
            <button type="submit" class="btn admin-btn">Filter</button>
        </form>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Role</th>
                        <th>Membership</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.UserID</td>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.Phone</td>
                            <td>
                                @switch (user.Role)
                                {
                                    case LibraryWeb.Models.UserRole.Admin:
                                        <span class="badge role-admin">Administrator</span>
                                        break;
                                    case LibraryWeb.Models.UserRole.Employee:
                                        <span class="badge role-employee">Employee</span>
                                        break;
                                    default:
                                        <span class="badge role-user">User</span>
                                        break;
                                }
                            </td>
                            <td>@(user.Membership != null ? user.Membership.Type : "—")</td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@user.UserID" class="btn btn-edit">Edit</a>
                                <form asp-action="Delete" asp-route-id="@user.UserID" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-delete"
                                            onclick="return confirm('Are you sure you want to delete this user?');">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a asp-controller="Home" asp-action="AdminDashboard" class="btn btn-back">← Back to Dashboard</a>
    </div>
</main>