@model LibraryWeb.Models.User

@{
    ViewData["Title"] = "Edit User";
}

<main class="edit-profile-page">
    <div class="edit-profile-container">
        <h2 class="edit-profile-title">Edit User</h2>
        <p class="edit-profile-subtitle">Update user information below.</p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger edit-profile-alert">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success edit-profile-alert">@TempData["Success"]</div>
        }

        <form asp-action="Edit" asp-route-id="@Model.UserID" method="post" class="edit-profile-form">
            <input type="hidden" asp-for="UserID" />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter full name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Login</label>
                <input asp-for="Login" class="form-control" placeholder="Enter login" />
                <span asp-validation-for="Login" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="Enter email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Phone</label>
                <input asp-for="Phone" class="form-control" placeholder="Enter phone number" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Birth Date</label>
                <input asp-for="BirthDate" type="date" class="form-control" />
                <span asp-validation-for="BirthDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Role</label>
                <select asp-for="Role" class="form-select">
                    @foreach (var role in Enum.GetValues(typeof(LibraryWeb.Models.UserRole)))
                    {
                        <option value="@role" selected="@(Model.Role == (LibraryWeb.Models.UserRole)role)">
                            @role
                        </option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>

            <div class="button-group">
                <button type="submit" class="btn btn-primary">Save</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>
        </form>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
