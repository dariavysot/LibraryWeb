@model LibraryWeb.Models.User

@{
    ViewData["Title"] = "Профіль";
}

<h2>Профіль</h2>

@if (ViewBag.Success != null)
{
    <div class="alert alert-success">@ViewBag.Success</div>
}

<p><strong>Ім’я:</strong> @Model.Name</p>
<p><strong>Email:</strong> @Model.Email</p>
<p><strong>Login:</strong> @Model.Login</p>
<p><strong>Phone:</strong> @Model.Phone</p>
<p><strong>Роль:</strong> @Model.Role</p>

@if (Model.Membership != null)
{
    <h4>Членство:</h4>
    <p>
        Тип: @Model.Membership.MembershipType?.Name <br />
        Статус: @Model.Membership.Status <br />
        Ціна: @Model.Membership.Price.ToString("C") <br />
        Тривалість: @Model.Membership.MembershipType?.DurationMonths @((Model.Membership.MembershipType?.DurationMonths == 1) ? "місяць" : "місяців")
    </p>
}

<a asp-controller="EditProfile" asp-action="Index" class="btn btn-primary">Редагувати профіль</a>
<a asp-controller="Login" asp-action="Logout" class="btn btn-danger ms-2">Вийти</a>
