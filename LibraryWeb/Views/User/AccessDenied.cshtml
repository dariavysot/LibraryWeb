@{
    ViewData["Title"] = "Access Denied";
}

<div class="access-denied-page">
    <div class="access-denied-container">
        <h1 class="access-denied-title">Access Denied</h1>
        <p class="access-denied-text">
            You don’t have permission to view this page.
            Please check your account or return to your profile.
        </p>

        <a asp-controller="Profile" asp-action="Index" class="btn access-btn">Back to Profile</a>
    </div>
</div>
