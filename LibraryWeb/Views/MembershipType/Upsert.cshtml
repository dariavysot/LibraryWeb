@model LibraryWeb.Models.MembershipType

@{
    var membership = Model ?? new MembershipType();
    bool isNew = membership.MembershipTypeID == 0;
    ViewData["Title"] = isNew ? "Додати тип" : "Редагувати тип";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Upsert" asp-route-id="@(isNew ? null : membership.MembershipTypeID)" method="post">
    <input type="hidden" asp-for="MembershipTypeID" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DurationMonths" class="form-label"></label>
        <input asp-for="DurationMonths" class="form-control" type="number" />
        <span asp-validation-for="DurationMonths" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
