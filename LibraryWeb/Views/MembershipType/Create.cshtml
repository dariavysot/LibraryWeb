@model LibraryWeb.Models.MembershipType

@{
    ViewData["Title"] = "Add Membership Type";
}

<section class="edit-profile-page">
    <div class="edit-profile-container">
        <h2 class="edit-profile-title">@ViewData["Title"]</h2>
        <p class="edit-profile-subtitle">Fill in the details for the new membership type</p>

        <form asp-action="Create" method="post" class="edit-profile-form">
            <input type="hidden" asp-for="MembershipTypeID" />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Price</label>
                <input asp-for="Price" class="form-control" type="number" min="1" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">Duration (months)</label>
                <input asp-for="DurationMonths" class="form-control" type="number" min="0" step="0.1" />
                <span asp-validation-for="DurationMonths" class="text-danger"></span>
            </div>

            <div class="button-group">
                <button type="submit" class="btn edit-profile-form btn-primary">Save</button>
                <a asp-action="Index" class="btn edit-profile-form btn-secondary">Back</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
