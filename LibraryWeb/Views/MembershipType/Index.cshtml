@model IEnumerable<LibraryWeb.Models.MembershipType>

@{
    ViewData["Title"] = "Membership Types";
}

<section class="admin-page">
    <div class="membership-page-container">
        <h2 class="admin-title">Membership Types</h2>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="admin-alert-error">@TempData["Error"]</div>
        }

        @if (User.IsInRole("Admin"))
        {
            <div class="button-group mb-3">
                <a asp-action="Create" class="admin-btn">Add New Type</a>
            </div>
        }

        <div class="admin-grid">
            @foreach (var type in Model)
            {
                <div class="admin-card">
                    <h3>@type.Name</h3>
                    <p><strong>Duration:</strong> @type.DurationMonths months</p>
                    <p><strong>Price:</strong> @type.Price.ToString("C")</p>

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="admin-actions">
                            <a asp-action="Edit" asp-route-id="@type.MembershipTypeID" class="admin-btn">Edit</a>
                            <form asp-action="Delete" asp-route-id="@type.MembershipTypeID" method="post" style="display:inline">
                                <button type="submit" class="admin-btn admin-btn-dark" onclick="return confirm('Delete this membership type?')">Delete</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>

        @if (!Model.Any())
        {
            <p class="text-muted">No membership types found.</p>
        }
    </div>
</section>
