@{
    ViewData["Title"] = "Confirm Book Loan";

    var userLogin = ViewBag.UserLogin as string;
    var bookTitle = ViewBag.BookTitle as string;
    var reservedBy = ViewBag.ReservationUser as string;
    var reservationStartStr = ViewBag.ReservationStart as string;
    var reservationEndStr = ViewBag.ReservationEnd as string;

    DateTime? reservationStart = null;
    DateTime? reservationEnd = null;

    if (DateTime.TryParse(reservationStartStr, out DateTime startParsed))
    {
        reservationStart = startParsed;
    }
    if (DateTime.TryParse(reservationEndStr, out DateTime endParsed))
    {
        reservationEnd = endParsed;
    }
}

<div class="loan-page">
    <div class="loan-container loan-warning-container">
        <h2 class="loan-title">⚠️ Confirm Book Loan</h2>
        <p class="loan-subtitle">This book is currently available, but reserved by another user.</p>

        <div class="loan-warning-box">
            <p>
                The book <strong>@bookTitle</strong> has been reserved by
                <strong style="color:#b3541e;">@reservedBy</strong>.
            </p>

            @if (reservationStart.HasValue && reservationEnd.HasValue)
            {
                <p>
                    Reservation period:
                    <strong>@reservationStart.Value</strong> →
                    <strong>@reservationEnd.Value</strong>.
                    <br />
                    You may issue this book now, but it must be returned before the reservation begins.
                </p>
            }
        </div>

        <form asp-action="ConfirmLoanWarningPost" method="post" class="loan-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="UserLogin" value="@userLogin" />
            <input type="hidden" name="BookTitle" value="@bookTitle" />

            <p class="loan-question">Do you want to confirm a short-term loan?</p>

            <div class="loan-actions">
                <button type="submit" class="loan-btn loan-btn-primary">Yes, Confirm</button>
                <a asp-action="Create" class="loan-btn loan-btn-outline">Cancel</a>
            </div>
        </form>
    </div>
</div>
