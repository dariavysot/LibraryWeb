@model IEnumerable<LibraryWeb.Models.Loan>

<main class="admin-page">
    <div class="admin-container">
        <h2 class="admin-title">Loan List</h2>
        <p class="admin-subtitle">Here you can view and manage all book loans in the library.</p>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="admin-alert-error">@TempData["Warning"]</div>
        }

        <div class="mb-3">
            <a asp-action="Create" class="admin-btn">Add Loan</a>
        </div>

        <form method="get" asp-action="Index" class="admin-filter-form">
            <select name="statusFilter" class="form-select">
                @foreach (var status in (List<string>)ViewBag.Statuses)
                {
                    <option value="@status" selected="@(ViewBag.StatusFilter == status)">
                        @status
                    </option>
                }
            </select>

            <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by book..." class="form-control" />

            <input type="text" name="inventoryFilter" value="@ViewBag.InventoryFilter" placeholder="Copy #" class="form-control" />

            <input type="text" name="userFilter" value="@ViewBag.UserFilter" placeholder="User..." class="form-control" />

            <input type="date" name="dateFilter" value="@ViewBag.DateFilter" class="form-control" />

            <button type="submit" class="admin-btn">Filter</button>
        </form>

        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Book</th>
                        <th>Copy #</th>
                        <th>User</th>
                        <th>Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td>@loan.LoanID</td>
                            <td>@loan.Copy.Book.Title</td>
                            <td>@loan.InventoryNum</td>
                            <td>@(loan.User?.Name ?? loan.UserName ?? "—")</td>
                            <td>
                                <span class="badge @(loan.Status == "Активна" ? "role-user" : loan.Status == "Прострочена" ? "role-employee" : "role-admin")">
                                    @loan.Status
                                </span>
                            </td>
                            <td>@loan.StartDate.ToShortDateString()</td>
                            <td>@loan.EndDate.ToShortDateString()</td>
                            <td class="button-group">
                                @if (loan.Status != "Повернено")
                                {
                                    <a asp-action="Return" asp-route-id="@loan.LoanID" class="btn-edit btn-yellow">Return</a>
                                }

                                <a asp-action="Details" asp-route-id="@loan.LoanID" class="btn-edit btn-blue">Details</a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Delete" asp-route-id="@loan.LoanID" method="post" onsubmit="return confirm('Are you sure you want to delete this loan?');">
                                        <button type="submit" class="btn-delete">Delete</button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
