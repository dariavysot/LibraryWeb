@{
    ViewData["Title"] = "Позики";
}

<h2>Список позик</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="mb-3">
    <a asp-controller="Loan" asp-action="Index" asp-route-statusFilter="All" class="btn btn-secondary btn-sm">Всі</a>
    <a asp-controller="Loan" asp-action="Index" asp-route-statusFilter="Active" class="btn btn-primary btn-sm">Активні</a>
    <a asp-controller="Loan" asp-action="Index" asp-route-statusFilter="Overdue" class="btn btn-danger btn-sm">Прострочені</a>
    <a asp-controller="Loan" asp-action="Index" asp-route-statusFilter="Returned" class="btn btn-success btn-sm">Повернені</a>
</div>

@await Component.InvokeAsync("LoanList", new { statusFilter = ViewBag.StatusFilter ?? "All" })

<a asp-action="Create" class="btn btn-primary mt-3">Додати позику</a>
