@model IEnumerable<LibraryWeb.Models.Loan>

@{
    ViewData["Title"] = "Loans";
}

<main class="loan-main-page">
    <div class="loan-main-container">
        <h2 class="loan-main-title">Loan List</h2>
        <p class="loan-main-subtitle">Manage all book loans in the library</p>

        @if (TempData["Success"] != null)
        {
            <div class="loan-alert loan-alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="loan-alert loan-alert-error">@TempData["Warning"]</div>
        }

        <div class="button-group mb-3">
            <a asp-action="Create" class="loan-main-btn loan-main-btn-primary">Add Loan</a>
        </div>

        <form method="get" asp-action="Index" class="loan-form">
            <div class="book-form-row">
                <div class="book-form-group">
                    <label class="loan-main-label">Loan ID</label>
                    <input type="text" name="searchId" value="@ViewBag.SearchId" class="loan-main-input" placeholder="Search by loan ID" />
                </div>
                <div class="book-form-group">
                    <label class="loan-main-label">User Name / Login</label>
                    <input type="text" name="searchUser" value="@ViewBag.SearchUser" class="loan-main-input" placeholder="Search by Name or login" />
                </div>
            </div>

            <div class="book-form-row">
                <div class="book-form-group">
                    <label class="loan-main-label">Book Title</label>
                    <input type="text" name="searchBook" value="@ViewBag.SearchBook" class="loan-main-input" placeholder="Search by Book title" />
                </div>
                <div class="book-form-group">
                    <label class="loan-main-label">Inventory Number</label>
                    <input type="text" name="searchInventory" value="@ViewBag.SearchInventory" class="loan-main-input" placeholder="Search by Inventory #" />
                </div>
            </div>

            <div class="loan-main-form-row">
                <div class="loan-main-form-group">
                    <label class="loan-main-label">Status</label>
                    <select name="statusFilter" class="loan-main-select">
                        @foreach (var status in (List<string>)ViewBag.Statuses)
                        {
                            <option value="@status" selected="@(ViewBag.StatusFilter == status)">
                                @status
                            </option>
                        }
                    </select>
                </div>
                <div class="loan-main-form-group">
                    <label class="loan-main-label">Date From</label>
                    <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="loan-main-input" />
                </div>
                <div class="loan-main-form-group">
                    <label class="loan-main-label">Date To</label>
                    <input type="date" name="dateTo" value="@ViewBag.DateTo" class="loan-main-input" />
                </div>
            </div>

            <div class="loan-main-form-actions">
                <button type="submit" class="loan-main-btn loan-main-btn-primary">Search</button>
                <a href="/loans" class="loan-main-btn loan-main-btn-outline">Reset</a>
            </div>
        </form>

        <div class="table-responsive" style="margin-top:2rem;">
            <table class="loan-main-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Book</th>
                        <th>Copy #</th>
                        <th>User</th>
                        <th>Status</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in Model)
                    {
                        <tr>
                            <td>@loan.LoanID</td>
                            <td>@loan.Copy.Book.Title</td>
                            <td>@loan.InventoryNum</td>
                            <td>@(loan.User?.Name ?? loan.UserName ?? "—")</td>
                            <td>
                                <span class="loan-main-badge @(loan.Status == "Активна" ? "loan-main-active" : loan.Status == "Прострочена" ? "loan-main-overdue" : "loan-main-returned")">
                                    @loan.Status
                                </span>
                            </td>
                            <td>@loan.StartDate.ToShortDateString()</td>
                            <td>@loan.EndDate.ToShortDateString()</td>
                            <td class="button-group">
                                @if (loan.Status != "Повернено")
                                {
                                    <a asp-action="Return" asp-route-id="@loan.LoanID" class="loan-main-action-btn loan-main-btn-return">Return</a>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <form asp-action="Delete" asp-route-id="@loan.LoanID" method="post" onsubmit="return confirm('Are you sure you want to delete this loan?');" style="display:inline-block;">
                                        <button type="submit" class="loan-main-action-btn loan-main-btn-delete">Delete</button>
                                        @Html.AntiForgeryToken()
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</main>
