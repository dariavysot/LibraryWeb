@model LibraryWeb.Models.Loan

@{
    ViewData["Title"] = "Повернення книги";
}

<h2>Повернення книги</h2>

<form asp-action="ReturnConfirmed" asp-route-id="@Model.LoanID" method="post">
    <div class="form-group mb-3">
        <label>Книга:</label>
        <p class="form-control-plaintext">@Model.Copy.Book.Title</p>
    </div>

    <div class="form-group mb-3">
        <label>Читач:</label>
        <p class="form-control-plaintext">@Model.User.Name</p>
    </div>

    <div class="form-group mb-3">
        <label>Дата позики:</label>
        <p class="form-control-plaintext">@Model.StartDate.ToShortDateString()</p>
    </div>

    <div class="form-group mb-3">
        <label>Планова дата повернення:</label>
        <p class="form-control-plaintext">@Model.EndDate.ToShortDateString()</p>
    </div>

    <div class="form-group mb-3">
        <label>Фактична дата повернення:</label>
        <input type="date" name="returnDate" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
    </div>

    <div class="form-group mb-3">
        <label>Стан книги:</label>
        <select name="condition" class="form-control" required>
            <option value="Добра">Добра</option>
            <option value="Пошкоджена">Пошкоджена</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Підтвердити повернення</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
