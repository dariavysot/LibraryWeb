@model LibraryWeb.Models.Loan

@{
    ViewData["Title"] = "Return Book";
}

<div class="loan-page">
    <div class="loan-container">
        <h2 class="loan-title">Return Book</h2>
        <p class="loan-subtitle">Please confirm the return details below.</p>

        <form asp-action="ReturnConfirmed" asp-route-id="@Model.LoanID" method="post" class="loan-form">
            <div class="loan-form-group">
                <label class="loan-label">Book</label>
                <p class="loan-info">@Model.Copy.Book.Title</p>
            </div>

            <div class="loan-form-group">
                <label class="loan-label">Reader</label>
                <p class="loan-info">@Model.User?.Name</p>
            </div>

            <div class="loan-form-group">
                <label class="loan-label">Loan Date</label>
                <p class="loan-info">@Model.StartDate.ToShortDateString()</p>
            </div>

            <div class="loan-form-group">
                <label class="loan-label">Planned Return Date</label>
                <p class="loan-info">@Model.EndDate.ToShortDateString()</p>
            </div>

            <div class="loan-form-group">
                <label for="returnDate" class="loan-label">Actual Return Date</label>
                <input type="date" id="returnDate" name="returnDate"
                       class="loan-input" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="loan-form-group">
                <label for="condition" class="loan-label">Book Condition</label>
                <select id="condition" name="condition" class="loan-input" required>
                    <option value="Добра">Good</option>
                    <option value="Пошкоджена">Damaged</option>
                </select>
            </div>

            <div class="loan-actions">
                <button type="submit" class="loan-btn loan-btn-primary">Confirm Return</button>
                <a asp-action="Index" class="loan-btn loan-btn-outline">Back</a>
            </div>
        </form>
    </div>
</div>
