@model LibraryWeb.Models.Loan

<h2>Редагування позики</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="LoanID" />

    <div class="mb-3">
        <label>Читач</label>
        <select asp-for="ReaderID" class="form-control" asp-items="@(new SelectList(ViewBag.Users, "UserID", "Name", Model.ReaderID))"></select>
    </div>

    <div class="mb-3">
        <label>Примірник книги</label>
        <select asp-for="InventoryNum" class="form-control" asp-items="@(new SelectList(ViewBag.Copies, "InventoryNum", "Book.Title", Model.InventoryNum))"></select>
    </div>

    <div class="mb-3">
        <label>Початок</label>
        <input asp-for="StartDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Кінець</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Статус</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
