@{
    ViewData["Title"] = "The Private Shelf";
}

@section Hero {
    <main></main>
    <div class="hero-section">
        <div class="hero-content">
            <div class="text-content">
                <p class="best-choice">BEST CHOICE</p>
                <h1>THE PRIVATE SHELF</h1>

                <form asp-controller="Book" asp-action="Index" method="get" class="search-form">
                    <input type="text" name="search" placeholder="Enter a title or author..." required />
                    <button type="submit">Go to catalog →</button>
                </form>

                <p class="description">
                    Regular reading allows you to better formulate your own thoughts.
                    Our <a asp-controller="Home" asp-action="Team">team of professionals</a>
                    will always help you make up your mind and find a book for fun activities.
                </p>
            </div>

            <div class="book-display">
                <div class="book orange">CLASSIC</div>
                <div class="book blue">MODERN ART</div>
                <div class="book yellow">NONFICTION</div>
            </div>
        </div>
    </div>
}
