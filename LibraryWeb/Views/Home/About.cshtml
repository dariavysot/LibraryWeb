@{
    ViewData["Title"] = "About Us";
}

<!-- Hero секція -->
<section class="about-hero">
    <div class="hero-overlay">
        <div class="container hero-content">
            <h1 class="hero-title">About Us</h1>
            <p class="hero-subtitle">
                We are committed to bringing the best library experience to our readers.
            </p>
        </div>
    </div>
</section>


<!-- Місія та історія з оранжевим фоном -->
<section class="about-mission">
    <div class="container">
        <h2 class="section-title">Our Mission</h2>
        <p class="section-text">
            Founded in 2025, our library strives to make knowledge accessible to everyone.
            We believe in fostering a love for reading, learning, and community engagement.
        </p>

        <h2 class="section-title mt-5">Our Story</h2>
        <p class="section-text">
            Starting as a small community library, we have grown into a hub for readers and learners.
            Our values include inclusivity, innovation, and passion for education.
        </p>
    </div>
</section>

<!-- Цінності з оранжевими акцентами -->
<section class="about-values">
    <div class="container">
        <h2 class="section-title orange-title">Our Values</h2>
        <div class="values-grid">
            <div class="value-card orange-border">
                <img width="64" height="64" src="https://img.icons8.com/parakeet-line/48/people-working-together.png" alt="people-working-together" />
                <h4>Community</h4>
                <p>We build a strong and inclusive library community.</p>
            </div>
            <div class="value-card orange-border">
                <img width="64" height="64" src="https://img.icons8.com/ios/50/education.png" alt="education" />
                <h4>Education</h4>
                <p>Promoting lifelong learning for everyone.</p>
            </div>
            <div class="value-card orange-border">
                <img width="64" height="64" src="https://img.icons8.com/laces/64/innovation.png" alt="innovation" />
                <h4>Innovation</h4>
                <p>Embracing technology to improve reader experience.</p>
            </div>
        </div>
    </div>
</section>

