@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="admin-dashboard">
    <h1 class="admin-title">Admin Dashboard</h1>
    <p class="admin-subtitle">Manage all sections of your library system below.</p>

    <div class="admin-grid">
        <div class="admin-card">
            <h3>Books</h3>
            <p>Total books: <strong>@ViewBag.TotalBooks</strong></p>
            <a asp-controller="Book" asp-action="Index" class="admin-btn admin-btn-orange">View Books</a>
        </div>

        <div class="admin-card">
            <h3>Users</h3>
            <p>Total users: <strong>@ViewBag.TotalUsers</strong></p>
            <a asp-controller="User" asp-action="Index" class="admin-btn admin-btn-orange">Manage Users</a>
        </div>

        <div class="admin-card">
            <h3>Membership Types</h3>
            <p>Total: <strong>@ViewBag.TotalMemberships</strong></p>
            <a asp-controller="MembershipType" asp-action="Index" class="admin-btn admin-btn-orange">Memberships</a>
        </div>

        <div class="admin-card">
            <h3>Loans</h3>
            <p>Active loans: <strong>@ViewBag.ActiveLoans</strong></p>
            <a asp-controller="Loan" asp-action="Index" class="admin-btn admin-btn-orange">View Loans</a>
        </div>

        <div class="admin-card wide">
            <h3>Quick Actions</h3>
            <p>Add books, edit memberships, or manage users directly.</p>
            <div class="admin-actions">
                <a asp-controller="Book" asp-action="Create" class="admin-btn admin-btn-dark">Add Book</a>
                <a asp-controller="MembershipType" asp-action="Create" class="admin-btn admin-btn-dark">Add Membership</a>
            </div>
        </div>
    </div>
</section>
