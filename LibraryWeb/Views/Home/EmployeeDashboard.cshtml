@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="admin-dashboard">
    <h2 class="admin-title">Employee Dashboard</h2>
    <p class="admin-subtitle">Quick access to main functions</p>

    <div class="admin-grid">
        <div class="admin-card">
            <h3>Books</h3>
            <p>Total books: <strong>@ViewBag.TotalBooks</strong></p>
            <a asp-controller="Book" asp-action="Index" class="admin-btn admin-btn-orange">View Books</a>
        </div>

        <div class="admin-card">
            <h3>Loans</h3>
            <p>Active loans: <strong>@(ViewBag.ActiveLoans ?? "No data")</strong></p>
            <a asp-controller="Loan" asp-action="Index" class="admin-btn admin-btn-orange">View Loans</a>
        </div>

        <div class="admin-card">
            <h3>Reservations</h3>
            <p>Total reservations: <strong>@ViewBag.TotalReservations</strong></p>
            <a asp-controller="AdminReservation" asp-action="Index" class="admin-btn admin-btn-orange">
                View Reservations
            </a>
        </div>

        <div class="admin-card wide">
            <h3>Quick Actions</h3>
            <p>The employee can issue and return books, manage user memberships.</p>
            <div class="admin-actions">
                <a asp-controller="Loan" asp-action="Create" class="admin-btn admin-btn-dark me-2">Issue a Loan</a>
            </div>
        </div>

        <div class="admin-card">
            <h3>Payments</h3>
            <p>View and filter all payments</p>
            <a asp-controller="Payment" asp-action="Index" class="admin-btn admin-btn-orange">View Payments</a>
        </div>
    </div>
</div>
