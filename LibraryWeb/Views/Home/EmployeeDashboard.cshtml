@{
    ViewData["Title"] = "Панель працівника";
}

<h2>Панель працівника</h2>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card p-3 mb-3 shadow-sm">
            <h5>Книги</h5>
            <p>Усього книг: <strong>@ViewBag.TotalBooks</strong></p>
            <a asp-controller="Book" asp-action="Index" class="btn btn-primary btn-sm">Переглянути книги</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 mb-3 shadow-sm">
            <h5>Активні членства</h5>
            <p>Кількість: <strong>@ViewBag.ActiveMemberships</strong></p>
            <a asp-controller="Membership" asp-action="Index" class="btn btn-primary btn-sm">Переглянути членства</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 mb-3 shadow-sm">
            <h5>Позики</h5>
            <p>Активні позики: <strong>@(ViewBag.ActiveLoans ?? "немає даних")</strong></p>
            <a asp-controller="Loan" asp-action="Index" class="btn btn-warning btn-sm">Переглянути позики</a>
        </div>
    </div>
</div>

<div class="row mt-3">
    <div class="col-md-12">
        <div class="card p-3 mb-3 shadow-sm">
            <h5>Швидкі дії</h5>
            <p>Працівник може оформлювати та повертати книги, переглядати членства користувачів.</p>
            <div class="mt-2">
                <a asp-controller="Loan" asp-action="Create" class="btn btn-success btn-sm me-2">Оформити позику</a>
                <a asp-controller="Loan" asp-action="ReturnBook" class="btn btn-success btn-sm">Повернути книгу</a>
            </div>
        </div>
    </div>
</div>
