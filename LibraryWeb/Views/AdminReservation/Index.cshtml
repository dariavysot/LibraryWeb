@model List<LibraryWeb.Models.Reservation>

<h2>Усі резервації</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">
        @TempData["Success"]
    </div>
}

<form method="get" class="mb-3">
    <div class="row mb-2">
        <div class="col-md-3">
            <label>ID резервації</label>
            <input type="text" name="searchId" value="@ViewBag.SearchId"
                   class="form-control"
                   placeholder="Введіть ID" />
        </div>

        <div class="col-md-3">
            <label>Ім’я / Логін користувача</label>
            <input type="text" name="searchUser" value="@ViewBag.SearchUser"
                   class="form-control"
                   placeholder="Ім’я або логін" />
        </div>
    </div>

    <div class="row mb-2">
        <div class="col-md-3">
            <label>Назва книги</label>
            <input type="text" name="searchBook" value="@ViewBag.SearchBook"
                   class="form-control"
                   placeholder="Назва книги" />
        </div>

        <div class="col-md-3">
            <label>Інвентарний номер</label>
            <input type="text" name="searchInventory" value="@ViewBag.SearchInventory"
                   class="form-control"
                   placeholder="Інв. номер" />
        </div>
    </div>

    <div class="row mb-2">
        <div class="col-md-2">
            <label>Статус</label>
            <select name="status" class="form-control">
                <option value="">Всі</option>
                <option value="Очікує оплату" selected="@(ViewBag.Status == "Очікує оплату")">Очікує оплату</option>
                <option value="Активна" selected="@(ViewBag.Status == "Активна")">Активна</option>
                <option value="Скасована" selected="@(ViewBag.Status == "Скасована")">Активна</option>
            </select>
        </div>

        <div class="col-md-2">
            <label>Дата від</label>
            <input type="date" name="dateFrom" value="@ViewBag.DateFrom" class="form-control" />
        </div>

        <div class="col-md-2">
            <label>Дата до</label>
            <input type="date" name="dateTo" value="@ViewBag.DateTo" class="form-control" />
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary me-2" type="submit">Пошук</button>
            <a href="/admin/reservations" class="btn btn-secondary">Скинути</a>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning mt-3">
        Немає результатів за вашим запитом.
    </div>
}
else
{
    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Користувач</th>
                <th>Книга</th>
                <th>Інвентарний №</th>
                <th>Початок</th>
                <th>Кінець</th>
                <th>Статус</th>
                <th>Сума</th>
                <th>Дія</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.ReservationID</td>
                    <td>@r.User?.Name</td>
                    <td>@r.Copy?.Book?.Title</td>
                    <td>@r.InventoryNum</td>
                    <td>@r.StartDate.ToShortDateString()</td>
                    <td>@r.EndDate.ToShortDateString()</td>
                    <td>@r.Status</td>
                    <td>@r.Amount</td>
                    <td>
                        <form method="post" action="/admin/reservations/delete/@r.ReservationID" style="display:inline;">
                            @Html.AntiForgeryToken()
                            <button class="btn btn-danger btn-sm" onclick="return confirm('Видалити резервацію?')">Видалити</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

