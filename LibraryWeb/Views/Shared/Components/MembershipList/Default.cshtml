@model Tuple<List<LibraryWeb.Models.MembershipType>, LibraryWeb.Models.User>

@{
    var membershipTypes = Model?.Item1 ?? new List<LibraryWeb.Models.MembershipType>();
    var user = Model?.Item2;
}

@if (membershipTypes.Any())
{
    <table class="table table-bordered mt-3">
        <thead>
            <tr>
                <th>Тип членства</th>
                <th>Ціна</th>
                <th>Тривалість</th>
                <th>Дія</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in membershipTypes)
            {
                <tr>
                    <td>@type.Name</td>
                    <td>@type.Price.ToString("C")</td>
                    <td>@type.DurationMonths @((type.DurationMonths == 1) ? "місяць" : "місяців")</td>
                    <td>
                        <form asp-controller="Membership"
                              asp-action="CreateForUser"
                              asp-route-userId="@user?.UserID"
                              method="post">
                            <input type="hidden" name="membershipTypeId" value="@type.MembershipTypeID" />
                            <button type="submit" class="btn btn-primary">Оформити</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Немає доступних типів членства.</p>
}
