@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Private Shelf</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-custom">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark fw-bold">
                The Private Shelf
            </a>
        </div>

        <nav class="nav-left">
            <a class="nav-link text-dark" asp-controller="Home" asp-action="@(
                                                                                                                                     (User?.Identity?.IsAuthenticated ?? false)
                                                                                                                                         ? (User.IsInRole("Admin") ? "AdminDashboard"
                                                                                                                                         : User.IsInRole("Employee") ? "EmployeeDashboard"
                                                                                                                                         : "ReaderDashboard")
                                                                                                                                         : "Index"
                          )">Home</a>

            <a class="nav-link text-dark" asp-controller="Home" asp-action="About">About us</a>
            <a class="nav-link text-dark" asp-controller="Home" asp-action="Team">Team</a>

        </nav>
        <div class="nav-right">
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <div class="dropdown d-inline-block ms-3">
                    <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @User.Identity?.Name
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a></li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li><a class="dropdown-item" asp-controller="MembershipType" asp-action="Index">Manage Memberships</a></li>
                            <li><a class="dropdown-item" asp-controller="Book" asp-action="Index">Manage Books</a></li>
                        }
                        else if (User.IsInRole("Employee"))
                        {
                            <li><a class="dropdown-item" asp-controller="Loan" asp-action="Index">Manage Loans</a></li>
                            <li><a class="dropdown-item" asp-controller="Copies" asp-action="Index" asp-route-bookId="0">Manage Copies</a></li>
                        }
                        <li><hr class="dropdown-divider" /></li>
                        <li><a class="dropdown-item" asp-controller="Login" asp-action="Logout">Logout</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Login" asp-action="Index" class="signup-btn">Sign up</a>
            }
        </div>
    </header>

    <!-- Hero Section для головної сторінки -->
    @RenderSection("Hero", required: false)

    <!-- Основний контент -->
    <main role="main" class="pb-3 main-container">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-3 text-center py-3">
        &copy; 2025 - The Private Shelf
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
