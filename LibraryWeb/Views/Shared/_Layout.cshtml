@using System.Security.Claims
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Private Shelf</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/LibraryWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="navbar-custom">
        <div class="logo-wrapper">
            <div class="logo">
                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-dark fw-bold">
                    The Private Shelf
                </a>
            </div>
        </div>

            <div class="nav-left-wrapper">
                <nav class="nav-left">
                    <a class="nav-link text-dark" asp-controller="Home" asp-action="@(
                                                                                        (User?.Identity?.IsAuthenticated ?? false)
                                                                                            ? (User.IsInRole("Admin") ? "AdminDashboard"
                                                                                            : User.IsInRole("Employee") ? "EmployeeDashboard"
                                                                                            : "ReaderDashboard")
                                                                                            : "Index"
                        )">Home</a>

                    @if (User?.Identity?.IsAuthenticated ?? false)
                    {
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="nav-link text-dark" asp-controller="Book" asp-action="Index">Books</a>
                            <a class="nav-link text-dark" asp-controller="Loan" asp-action="Index">Loans</a>
                            <a class="nav-link text-dark" asp-controller="AdminReservation" asp-action="Index">Reservations</a>
                            <a class="nav-link text-dark" asp-controller="Payment" asp-action="Index">Payments</a>
                        }
                        else if (User.IsInRole("Employee"))
                        {
                            <a class="nav-link" asp-controller="Book" asp-action="Index">Books</a>
                            <a class="nav-link" asp-controller="Loan" asp-action="Index">Loans</a>
                            <a class="nav-link" asp-controller="Reservation" asp-action="Index">Reservations</a>
                        }
                        else
                        {
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="About">About us</a>
                            <a class="nav-link text-dark" asp-controller="Home" asp-action="Team">Team</a>
                        }
                    }
                    else
                    {
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="About">About us</a>
                        <a class="nav-link text-dark" asp-controller="Home" asp-action="Team">Team</a>
                    }
                </nav>
            </div>


        <div class="nav-right">
            <form asp-controller="Book" asp-action="Index" method="get" class="nav-search-wrapper">
                <div class="nav-search">
                    <input type="text" name="search" placeholder="Search books..." class="nav-search-input" />
                    <button type="submit" class="nav-search-btn">
                        <img width="25" height="25" src="https://img.icons8.com/ios-glyphs/30/search--v1.png" alt="search" />
                    </button>
                </div>
            </form>
            @if (User?.Identity?.IsAuthenticated ?? false)
            {
                <div class="dropdown d-inline-block ms-3">
                    <a class="nav-link dropdown-toggle text-dark"
                       href="javascript:void(0)"
                       id="userDropdown"
                       role="button"
                       data-bs-toggle="dropdown"
                       aria-expanded="false">
                        @User.Identity?.Name
                    </a>

                    <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Index">Profile</a></li>
                        <li><a class="dropdown-item" asp-controller="Profile" asp-action="Edit">Settings</a></li>

                        <li><hr class="dropdown-divider" /></li>

                        <li><a class="dropdown-item" asp-controller="Login" asp-action="Logout">Logout</a></li>
                    </ul>
                </div>
            }
            else
            {
                <a asp-controller="Login" asp-action="Index" class="signup-btn">Sign up</a>
            }
        </div>
    </header>

    <!-- Hero Section для головної сторінки -->
    @RenderSection("Hero", required: false)

    <!-- Основний контент -->
    <main role="main" class="pb-3 main-container">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted mt-3 text-center py-3">
        &copy; 2025 - The Private Shelf
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
