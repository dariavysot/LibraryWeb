@model IEnumerable<LibraryWeb.Models.Payment>

@{
    ViewData["Title"] = "Платежі";
}

<h2 class="mb-4">Список платежів</h2>

<form method="get" class="row mb-4">
    <div class="col-md-2">
        <label class="form-label">Статус</label>
        <select name="status" class="form-select">
            <option value="">Усі</option>
            @foreach (var s in ViewBag.StatusList)
            {
                <option value="@s" selected="@(Context.Request.Query["status"] == s)">
                    @s
                </option>
            }
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Тип</label>
        <select name="type" class="form-select">
            <option value="">Усі</option>
            @foreach (var t in ViewBag.TypeList)
            {
                <option value="@t" selected="@(Context.Request.Query["type"] == t)">
                    @t
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Користувач (ID або ім'я)</label>
        <input type="text" name="userSearch" class="form-control"
               placeholder="Введіть ID або ім'я"
               value="@Context.Request.Query["userSearch"]" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Від дати</label>
        <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
    </div>

    <div class="col-md-2">
        <label class="form-label">До дати</label>
        <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />
    </div>

    <div class="col-md-1 d-flex align-items-end">
        <button type="submit" class="btn btn-primary w-100">Фільтрувати</button>
    </div>
</form>

@if (Model.Any())
{
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>PaymentID</th>
                <th>Користувач</th>
                <th>Сума</th>
                <th>Дата</th>
                <th>Тип</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td>@p.PaymentID</td>
                    <td>@p.UserName</td>
                    <td>@p.Amount</td>
                    <td>@p.Date.ToShortDateString()</td>
                    <td>@p.Type</td>
                    <td>@p.Status</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Немає платежів за заданими критеріями.</p>
}

@if (Model.Any())
{
    <div class="mt-3">
        <h5><strong>Total amount:</strong> @ViewBag.TotalAmount.ToString("C")</h5>
    </div>
}

