@model IEnumerable<LibraryWeb.Models.Payment>

@{
    ViewData["Title"] = "Payments";
}

<section class="admin-page">
    <div class="admin-container">
        <h2 class="admin-title mb-4">Payments List</h2>

        @if (TempData["Success"] != null)
        {
            <div class="admin-alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="admin-alert-error">@TempData["Error"]</div>
        }

        <form method="get" class="admin-filter-form mb-4">
            <select name="status" class="form-select">
                <option value="">All statuses</option>
                @foreach (var s in ViewBag.StatusList)
                {
                    <option value="@s" selected="@(Context.Request.Query["status"] == s)">
                        @s
                    </option>
                }
            </select>

            <select name="type" class="form-select">
                <option value="">All types</option>
                @foreach (var t in ViewBag.TypeList)
                {
                    <option value="@t" selected="@(Context.Request.Query["type"] == t)">
                        @t
                    </option>
                }
            </select>

            <input type="text" name="userSearch" class="form-control"
                   placeholder="User ID or Name"
                   value="@Context.Request.Query["userSearch"]" />

            <input type="date" name="fromDate" class="form-control" value="@Context.Request.Query["fromDate"]" />
            <input type="date" name="toDate" class="form-control" value="@Context.Request.Query["toDate"]" />

            <button type="submit" class="admin-btn">Filter</button>
        </form>

        <div class="table-responsive">
            @if (Model.Any())
            {
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>PaymentID</th>
                            <th>User</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.PaymentID</td>
                                <td>@p.UserName</td>
                                <td>@p.Amount.ToString("C")</td>
                                <td>@p.Date.ToShortDateString()</td>
                                <td>@p.Type</td>
                                <td>@p.Status</td>
                            </tr>
                        }
                    </tbody>
                </table>

                <div class="mt-3 total-amount">
                    Total Amount: @ViewBag.TotalAmount.ToString("C")
                </div>

            }
            else
            {
                <p class="text-muted">No payments found for the selected filters.</p>
            }
        </div>
    </div>
</section>
