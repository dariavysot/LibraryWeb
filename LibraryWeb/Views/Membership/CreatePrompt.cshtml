@{
    ViewData["Title"] = "Membership Registration";
    var user = ViewBag.User as LibraryWeb.Models.User;
}

<div class="loan-page">
    <div class="loan-container loan-warning-container">
        <h2 class="loan-title">⚠️ Membership Registration</h2>
        <p class="loan-subtitle">The user does not have an active membership.</p>

        <div class="loan-warning-box">
            <p>
                The user <strong>@user?.Name</strong> does not have an active membership.
                Would you like to register it now?
            </p>

            @if (!string.IsNullOrEmpty(ViewBag.Error))
            {
                <p class="loan-alert loan-alert-error">@ViewBag.Error</p>
            }
        </div>

        <div class="loan-actions">
            <a asp-controller="Membership"
               asp-action="CreateForUser"
               asp-route-userId="@user?.UserID"
               class="loan-btn loan-btn-primary">
                Register Membership
            </a>

            <a asp-controller="Loan"
               asp-action="Index"
               class="loan-btn loan-btn-outline">
                Return to Book Loan
            </a>
        </div>
    </div>
</div>
