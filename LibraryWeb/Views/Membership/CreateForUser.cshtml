@model LibraryWeb.Models.Membership
@{
    ViewData["Title"] = "Оформлення членства";
    var user = ViewBag.User;
}

<h2>@ViewData["Title"]</h2>

<p>Оформлення членства для користувача: <strong>@user.Name</strong></p>

<form asp-controller="Membership"
      asp-action="CreateForUser"
      asp-route-userId="@user.UserID"
      method="post">
    @Html.AntiForgeryToken()

    <div class="form-group">
        <label for="Type">Тип членства</label>
        <select id="Type" name="Type" class="form-control" required>
            <option value="">Оберіть тип</option>
            <option value="Premium">Premium</option>
            <option value="Standard">Standard</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-2">Створити членство</button>
</form>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-2">@TempData["Error"]</div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-2">@TempData["Success"]</div>
}
