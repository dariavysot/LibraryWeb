@model LibraryWeb.Models.Membership

@{
    ViewData["Title"] = "Редагувати членство";
}

<h2>Редагувати членство</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="MembershipID" />

    <div class="form-group mb-3">
        <label>Тип членства</label>
        <select asp-for="Type" class="form-control" required>
            <option value="Standard" selected="@Model.Type == " Standard"">Standard</option>
            <option value="Premium" selected="@Model.Type == " Premium"">Premium</option>
        </select>
    </div>

    <div class="form-group mb-3">
        <label>Ціна</label>
        <input asp-for="Price" class="form-control" readonly />
    </div>

    <div class="form-group mb-3">
        <label>Статус</label>
        <input asp-for="Status" class="form-control" />
    </div>

    <div class="form-group mb-3">
        <label>Дата завершення</label>
        <input asp-for="EndDate" type="date" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Зберегти</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>
