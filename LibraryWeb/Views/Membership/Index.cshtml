@model LibraryWeb.Models.Membership

@{
    ViewData["Title"] = "My membership";
}

<div class="profile-page">
    <div class="profile-container">
        <h2 class="profile-title">@ViewData["Title"]</h2>
        <p class="admin-subtitle">Stay connected with the library through your membership</p>

        @if (TempData["Success"] != null)
        {
            <div class="auth-alert alert-success">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="auth-alert alert-danger">@TempData["Error"]</div>
        }

        <div class="profile-sections">
            @if (Model == null)
            {
                <div class="membership-card">
                    <h3>No Active Membership</h3>
                    <p>You currently do not have an active membership.</p>
                    <div class="profile-actions">
                        <a asp-action="Create" class="btn btn-dark">Create Membership</a>
                    </div>
                </div>
            }
            else
            {
                <div class="membership-card">
                    <h3>@Model.MembershipType?.Name</h3>
                    <p><span class="label">Price:</span> @Model.Price.ToString("C")</p>
                    <p><span class="label">Start Date:</span> @Model.StartDate.ToShortDateString()</p>
                    <p><span class="label">End Date:</span> @Model.EndDate.ToShortDateString()</p>
                    <p><span class="label">Status:</span> @Model.Status</p>

                    <div class="profile-actions">

                        @* Кнопка "Оплатити" тільки якщо є Payment і статус Очікує оплату *@
                        @if (Model.Payment?.Status == "Очікує оплату")
                        {
                            <form asp-controller="Payment"
                                  asp-action="ConfirmMembershipPayment"
                                  asp-route-paymentId="@Model.Payment.PaymentID"
                                  method="post" style="display:inline">
                                <button type="submit" class="btn btn-dark">💳 Pay</button>
                            </form>
                        }

                        <form asp-action="Delete" asp-route-id="@Model.MembershipID" method="post" style="display:inline"
                              onsubmit="return confirm('Скасувати членство?');">
                            <button type="submit" class="btn btn-outline-dark">Cancel</button>
                        </form>
                    </div>
                </div>
            }
		</div> 
        <a asp-controller="Home" asp-action="ReaderDashboard" class="btn btn-back">← Back to Dashboard</a>
    </div>
</div>
