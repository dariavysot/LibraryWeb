@model LibraryWeb.Models.Membership

@{
    ViewData["Title"] = "Оформити членство";
    var membershipTypes = ViewBag.MembershipTypes as List<LibraryWeb.Models.MembershipType>;
}

<h2>@ViewData["Title"]</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (membershipTypes != null && membershipTypes.Any())
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Назва</th>
                <th>Ціна</th>
                <th>Тривалість</th>
                <th>Дія</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var type in membershipTypes)
            {
                <tr>
                    <td>@type.Name</td>
                    <td>@type.Price.ToString("C")</td>
                    <td>@type.DurationMonths @((type.DurationMonths == 1) ? "місяць" : "місяців")</td>
                    <td>
                        <form asp-action="Create" method="post" style="display:inline">
                            <input type="hidden" name="MembershipTypeID" value="@type.MembershipTypeID" />
                            <button type="submit" class="btn btn-success">
                                Оформити
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p>Немає доступних типів членства.</p>
}

<a asp-action="Index" class="btn btn-secondary">Назад</a>
