@model IEnumerable<LibraryWeb.Models.Book>

@{
    ViewData["Title"] = "Book Catalog";
    bool isAdminOrEmployee = ViewBag.IsAdminOrEmployee ?? false;
}

<div class="catalog-page">
    <div class="catalog-container">
        <h2 class="catalog-title">Book Catalog</h2>
        <p class="catalog-subtitle">Discover our collection and explore your next favorite book</p>

        <form method="get" class="catalog-filter">
            <input type="text" name="search" value="@ViewBag.Search" class="filter-input"
                   placeholder="Search by title or author..." />

            <select name="genre" class="filter-select">
                <option value="">All Genres</option>
                @foreach (var g in ViewBag.Genres)
                {
                    <option value="@g" selected="@(ViewBag.Genre == g)">@g</option>
                }
            </select>

            <select name="year" class="filter-select">
                <option value="">All Years</option>
                @foreach (var y in ViewBag.Years)
                {
                    <option value="@y" selected="@(ViewBag.Year == y)">@y</option>
                }
            </select>

            <button type="submit" class="book-btn-primary">Search</button>
        </form>

        @if (!Model.Any())
        {
            <div class="catalog-empty">
                <p>No books found for your selection.</p>
            </div>
        }
        else
        {
            <div class="catalog-grid">
                @foreach (var book in Model)
                {
                    var availableCopies = book.Copies?.Count(c => c.Status == "Доступна") ?? 0;

                    <div class="catalog-card">
                        <div class="catalog-card-image">
                            <img src="@book.CoverImagePath" alt="@book.Title" />
                        </div>

                        <div class="catalog-card-content">
                            <h4>@book.Title</h4>
                            <p class="catalog-author">@book.Author</p>
                            <p class="catalog-meta">@book.Genre • @book.PublicationYear</p>
                            <p class="catalog-availability">
                                <strong>Available copies:</strong> @availableCopies
                            </p>
                        </div>

                        <div class="catalog-card-actions">
                            <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookID" class="book-btn-primary">Details</a>

                            @if (isAdminOrEmployee)
                            {
                                <a asp-action="Edit" asp-route-id="@book.BookID" class="book-btn-blue">Edit</a>
                                <a asp-controller="Copies" asp-action="Index" asp-route-bookId="@book.BookID" class="book-btn-secondary">Copies</a>
                            }
                            else
                            {
                                <a asp-controller="Reservation" asp-action="Create" asp-route-selectedBookId="@book.BookID" class="book-btn-blue">
                                    Reserve
                                </a>

                                @if (availableCopies == 0)
                                {
                                    <span class="catalog-unavailable">No copies available</span>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
