@model IEnumerable<LibraryWeb.Models.Book>

@using System.Security.Claims

@{
    ViewData["Title"] = "Каталог книг";
    bool canEditOrDelete = User.IsInRole("Admin") || User.IsInRole("Employee");
}

<h2 class="mb-3">📚 Каталог книг</h2>

<form method="get" class="mb-3">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Пошук за назвою або автором..." />
        </div>

        <div class="col-md-3">
            <select name="genre" class="form-select">
                <option value="">Усі жанри</option>
                @foreach (var g in ViewBag.Genres)
                {
                    <option value="@g" selected="@(ViewBag.Genre == g)">@g</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <select name="year" class="form-select">
                <option value="">Усі роки</option>
                @foreach (var y in ViewBag.Years)
                {
                    <option value="@y" selected="@(ViewBag.Year == y)">@y</option>
                }
            </select>
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">🔍 Пошук</button>
        </div>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-warning mt-3">
        Нічого не знайдено за вибраними параметрами.
    </div>
}
else
{
    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Назва</th>
                <th>Автор</th>
                <th>Тип</th>
                <th>Жанр</th>
                <th>Рік</th>
                <th>Видавництво</th>
                <th>Мова</th>
                <th>Доступні примірники</th>
                <th>Дії</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                var availableCopies = book.Copies?.Count(c => c.Status == "Доступна") ?? 0;

                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Type</td>
                    <td>@book.Genre</td>
                    <td>@book.PublicationYear</td>
                    <td>@book.PublishingHouse</td>
                    <td>@book.Language</td>
                    <td>@availableCopies</td>
                    <td>
                        <a asp-controller="Book" asp-action="Details" asp-route-id="@book.BookID" class="btn btn-outline-primary btn-sm">Деталі</a>

                        @if (canEditOrDelete)
                        {
                            <a asp-action="Edit" asp-route-id="@book.BookID" class="btn btn-warning btn-sm">Редагувати</a>
                            <a asp-controller="Copies" asp-action="Index" asp-route-bookId="@book.BookID" class="btn btn-info btn-sm">Примірники</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
