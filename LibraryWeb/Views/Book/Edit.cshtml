@model LibraryWeb.Models.Book

@{
    ViewData["Title"] = "Редагувати книгу";
    var currentYear = DateTime.Now.Year;
}

<form asp-action="Edit" asp-route-id="@Model.BookID" method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label class="form-label">Назва книги</label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Автор</label>
        <input asp-for="Author" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Тип</label>
        <input asp-for="Type" class="form-control" />
    </div>

    <div class="form-group">
        <label>Жанр</label>
        <input asp-for="Genre" class="form-control" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">ISBN</label>
        <input asp-for="ISBN" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Мова</label>
        <input asp-for="Language" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Видавництво</label>
        <input asp-for="PublishingHouse" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Рік видання</label>
        <input asp-for="PublicationYear" type="number" min="1" max="@currentYear" class="form-control" />
        <span asp-validation-for="PublicationYear" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Опис</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    </div>

    <div class="form-group">
        <label>Обкладинка</label>
        <input type="file" name="CoverImage" class="form-control" />
    </div>

    @if (!string.IsNullOrEmpty(Model?.CoverImagePath))
    {
        <div class="mt-2">
            <img src="@Model.CoverImagePath" alt="Cover" style="max-height:200px;" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Кількість примірників</label>
        <input name="copyCount" type="number" min="@(Model?.Copies?.Count ?? 0)" value="@(Model?.Copies?.Count ?? 0)"
               class="form-control" />
        <small>Не можна зменшити кількість копій, які вже позичені. Можна лише додавати нові.</small>
        @if (ViewBag.CopyCountError != null)
        {
            <span class="text-danger">@ViewBag.CopyCountError</span>
        }
    </div>

    <button type="submit" class="btn btn-primary">Зберегти зміни</button>
    <a asp-action="Index" class="btn btn-secondary">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
