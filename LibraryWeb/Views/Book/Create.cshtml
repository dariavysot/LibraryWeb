@model LibraryWeb.Models.Book

@{
    ViewData["Title"] = "Додати книгу";
    var currentYear = DateTime.Now.Year;
}

<h2 class="mb-3">➕ Додати нову книгу</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label class="form-label">Назва</label>
        <input asp-for="Title" class="form-control" required />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Автор</label>
        <input asp-for="Author" class="form-control" required />
        <span asp-validation-for="Author" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Тип</label>
        <input asp-for="Type" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Genre">Жанр</label>
        <input asp-for="Genre" class="form-control" />
        <span asp-validation-for="Genre" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">ISBN</label>
        <input asp-for="ISBN" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Мова</label>
        <input asp-for="Language" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Видавництво</label>
        <input asp-for="PublishingHouse" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Рік видання</label>
        <input asp-for="PublicationYear" type="number" min="1" max="@currentYear" class="form-control" />
        <span asp-validation-for="PublicationYear" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description">Description</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
    </div>

    <div class="form-group">
        <label>Cover Image</label>
        <input type="file" name="CoverImage" class="form-control" />
    </div>

    @if (!string.IsNullOrEmpty(Model?.CoverImagePath))
    {
        <div class="mt-2">
            <img src="@Model.CoverImagePath" alt="Cover" style="max-height:200px;" />
        </div>
    }

   <div class="mb-3">
        <label class="form-label">Кількість примірників</label>
        <input name="copyCount" type="number" min="1" value="1" class="form-control" required />
        @if (ViewBag.CopyCountError != null)
        {
            <span class="text-danger">@ViewBag.CopyCountError</span>
        }
    </div>

    <button type="submit" class="btn btn-success">Зберегти</button>
    <a asp-controller="Book" asp-action="Index" class="btn btn-secondary ms-2">Назад</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
