@model LibraryWeb.Models.Book

@{
    ViewData["Title"] = "Book Details";
    var availableCopies = Model.Copies?.Count(c => c.Status == "Доступна") ?? 0;
    bool isAdminOrEmployee = User.IsInRole("Admin") || User.IsInRole("Employee");
    bool isUser = User.IsInRole("User");
}

<div class="book-details-page">
    <div class="book-details-container">
        <h2 class="book-details-title">@Model.Title</h2>

        <div class="book-details-content">
            <div class="book-details-image">
                <img src="@Model.CoverImagePath" alt="@Model.Title" />
            </div>

            <div class="book-details-info">
                <dl>
                    <dt>Author:</dt>
                    <dd>@Model.Author</dd>

                    <dt>Type:</dt>
                    <dd>@Model.Type</dd>

                    <dt>Genre:</dt>
                    <dd>@Model.Genre</dd>

                    <dt>ISBN:</dt>
                    <dd>@Model.ISBN</dd>

                    <dt>Language:</dt>
                    <dd>@Model.Language</dd>

                    <dt>Publisher:</dt>
                    <dd>@Model.PublishingHouse</dd>

                    <dt>Year:</dt>
                    <dd>@Model.PublicationYear</dd>

                    <dt>Added on:</dt>
                    <dd>@Model.DateAdded.ToShortDateString()</dd>

                    <dt>Available Copies:</dt>
                    <dd class="text-success fw-bold">@availableCopies</dd>
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="book-details-description">
                <h4>Description</h4>
                <p>@Model.Description</p>
            </div>
        }

        @if (isAdminOrEmployee)
        {
            <div class="book-details-copies">
                <h4>Book Copies</h4>

                @if (Model.Copies != null && Model.Copies.Any())
                {
                    <table class="book-table">
                        <thead>
                            <tr>
                                <th>Inventory #</th>
                                <th>Condition</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var copy in Model.Copies)
                            {
                                <tr>
                                    <td>@copy.InventoryNum</td>
                                    <td>@copy.Condition</td>
                                    <td>@copy.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">No copies added yet.</p>
                }

                <div class="book-details-actions">
                    <a asp-controller="Copies" asp-action="Index" asp-route-bookId="@Model.BookID"
                       class="book-btn-primary">Manage Copies</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <a asp-controller="Book" asp-action="Edit" asp-route-id="@Model.BookID"
                           class="book-btn-edit">Edit</a>
                    }
                </div>
            </div>
        }

        @if (isUser)
        {
            <div class="book-details-actions">
                <a asp-controller="Reservations" asp-action="Create" asp-route-bookId="@Model.BookID"
                   class="book-btn-primary">Reserve Book</a>
            </div>
        }

        <div class="book-details-actions">
            <a asp-controller="Book" asp-action="Index" class="book-btn-secondary">← Back to List</a>
        </div>
    </div>
</div>
