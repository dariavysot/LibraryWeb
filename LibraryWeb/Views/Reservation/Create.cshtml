@{
    ViewData["Title"] = "New Reservation";
    var books = ViewBag.Books as List<LibraryWeb.Models.Book>;
    var prefillBook = ViewBag.PrefilledBookTitle as string ?? "";
}

<div class ="loan-page">
    <div class="loan-container">
        <h2 class="loan-title">Create a New Rservation</h2>
        <p class="loan-subtitle">
            Fill in the details for the new reservation.<a href="#"></a>
        </p>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }
        <form asp-action="Create" method="post" class="loan-form">
            @Html.AntiForgeryToken()
            <div class="loan-form-group">
                <label for="bookInput" class="loan-label">Book</label>
                <input list="booksList" id="bookInput" name="selectedBookTitle" class="loan-input"
                       placeholder="Start typing book title..." value="@prefillBook" />
                <datalist id="booksList">
                    @foreach (var book in (books ?? Enumerable.Empty<LibraryWeb.Models.Book>()))
                    {
                        <option value="@book.Title">@book.Title</option>
                    }
                </datalist>
            </div>

            <div class="loan-form-group">
                <label for="startDate" class="loan-label">Start Date</label>
                <input type="date" id="startDate" name="startDate" class="loan-input"
                       value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
            </div>

            <div class="loan-form-group">
                <label for="endDate" class="loan-label">End Date</label>
                <input type="date" id="endDate" name="endDate" class="loan-input"
                       value="@DateTime.Today.AddDays(14).ToString("yyyy-MM-dd")" required />
            </div>

            <div class="loan-form-group">
                <label for="bookInput" class="loan-label">Amount payable</label>
                <input type="text" id="paymentAmount" class="loan-input" readonly />
            </div>
            <div class="loan-actions">
                <button type="submit" class="loan-btn loan-btn-primary">Create Reservation</button>
                <a asp-action="Index" class="loan-btn loan-btn-outline">Back</a>
            </div>

        </form>
    </div>

</div>



@section Scripts {
    <script>
        const startInput = document.getElementById("startDate");
        const endInput = document.getElementById("endDate");
        const amountInput = document.getElementById("paymentAmount");
        const dailyRate = 50; // грн за день

        function calculateAmount() {
            const start = new Date(startInput.value);
            const end = new Date(endInput.value);
            if (!isNaN(start) && !isNaN(end) && end > start) {
                const days = Math.ceil((end - start) / (1000 * 60 * 60 * 24));
                amountInput.value = (days * dailyRate) + " грн";
            } else {
                amountInput.value = "";
            }
        }

        startInput.addEventListener("change", calculateAmount);
        endInput.addEventListener("change", calculateAmount);
        calculateAmount();
    </script>
}
